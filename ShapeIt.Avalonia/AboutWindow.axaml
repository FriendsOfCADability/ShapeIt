<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShapeIt.AboutWindow"
        Title="About ShapeIt"
        Icon="avares://ShapeIt/Logo.png"
        Width="560" Height="640"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

  <DockPanel Margin="16">

    <!-- Close button pinned to the bottom -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0 12 0 0">
      <Button x:Name="closeButton" Content="OK" MinWidth="80" Click="OnCloseClick"/>
    </StackPanel>

    <!-- Header: logo + title + version -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0 0 0 12">
      <Image Source="avares://ShapeIt/Logo.png" Width="64" Height="64"
             VerticalAlignment="Top"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="ShapeIt" FontSize="26" FontWeight="Bold"/>
        <TextBlock x:Name="versionText" FontSize="13" Opacity="0.8"/>
      </StackPanel>
    </StackPanel>

    <!-- Scrollable body -->
    <ScrollViewer>
      <StackPanel Spacing="10">

        <TextBlock x:Name="basedOnText" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock x:Name="moreInfoLabel" VerticalAlignment="Center"/>
          <HyperlinkButton x:Name="homepageLink" Padding="0"
                           Content="https://cadability.de/ShapeIt"
                           NavigateUri="https://cadability.de/ShapeIt"/>
        </StackPanel>

        <Separator Margin="0 6"/>

        <TextBlock x:Name="librariesHeader" FontWeight="Bold"/>
        <ItemsControl x:Name="librariesList" x:CompileBindings="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="#33808080" BorderThickness="0 0 0 1" Padding="0 4">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding License}" Opacity="0.7"/>
                  </StackPanel>
                  <TextBlock Text="{Binding Copyright}" FontSize="11" Opacity="0.7"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator Margin="0 6"/>

        <TextBlock x:Name="copyrightText" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>

      </StackPanel>
    </ScrollViewer>

  </DockPanel>

</Window>
