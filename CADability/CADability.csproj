<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>CADability</PackageId>
    <Version>1.0.22</Version>
    <!-- Update this for each publish -->
    <Authors>FriendsOfCADability</Authors>
    <Description>CAD functionality for .NET</Description>
    <RepositoryUrl>https://github.com/FriendsOfCADability/CADability</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>cad drawing winforms geometry netstandard net48</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <BuildDocFx Condition=" '$(Configuration)'!='RelWithDoc' ">false</BuildDocFx>
    <Configurations>Debug;Release;RelWithDoc;WebDebug</Configurations>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>CADabilityKey.snk</AssemblyOriginatorKeyFile>
    <AssemblyName>CADability</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

	  <LangVersion>latest</LangVersion>

    <!-- Allow nullable reference annotations ('?') without turning on nullable
         warnings; this silences CS8632 across the project. -->
    <Nullable>annotations</Nullable>

    <!-- Suppress warnings that are either intentional or not worth changing:
         CS0162 unreachable code (intentional debug switches, e.g. if(false)),
         CS0649/CS0169 vestigial fields kept for debugging/serialization,
         CS8002 third-party assembly (StbImageSharp) without a strong name,
         CS3005 legacy member names differing only in case. -->
    <NoWarn>$(NoWarn);CS0162;CS0649;CS0169;CS8002;CS3005</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>NET4X;TRACE;DEBUG;xTESTNEWCONTEXTMENU, xUSENONPRIODICSURFACES</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='WebDebug'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>TRACE;xPARALLEL, xTESTNEWCONTEXTMENU, xUSENONPRIODICSURFACES, WEBASSEMBLY</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>NET4X;xTESTNEWCONTEXTMENU</DefineConstants>
    <Optimize>True</Optimize>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <DocumentationFile />
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='RelWithDoc'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>xPARALLEL, xTESTNEWCONTEXTMENU</DefineConstants>
    <Optimize>False</Optimize>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <DocumentationFile />
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <!-- exclusions -->
    <RemoveFiles Include="CADability.DXF\**" />
    <RemoveFiles Include="DXF\**" />
    <RemoveFiles Include="_site\**" />
    <RemoveFiles Include="OpenGlList.cs" />
    <RemoveFiles Include="Scripting.cs" />
    <RemoveFiles Include="Tangulation.cs" />
    <RemoveFiles Include="log.txt" />
    <RemoveFiles Include="_ToDo.txt" />
    <RemoveFiles Include="WebDrawing.cs" Condition="'$(Configuration)'!='WebDebug'" />

    <EmbeddedResource Remove="@(RemoveFiles)" />
    <EmbeddedFiles Remove="@(RemoveFiles)" />
    <Resource Remove="@(RemoveFiles)" />
    <Compile Remove="@(RemoveFiles)" />
    <Compile Remove="DebuggerVisualizer.cs" />
    <Compile Remove="ParametricsExtrudeAction.cs" />
    <Compile Remove="ParametricsOffsetAction.cs" />
    <Compile Remove="ParametricsRadiusAction.cs" />
    <Compile Remove="PrintToGDI.cs" />
    <Compile Remove="SelectActionContextMenu.cs" />
    <Compile Remove="ToolsTrim.cs" />
    <Compile Remove="Triangulation.cs" />
    <Compile Remove="TriangulationSmoothing.cs" />
    <Content Remove="@(RemoveFiles)" />
    <None Remove="@(RemoveFiles)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="MenuResource.xml" />
    <EmbeddedResource Include="StringTableDeutsch.xml" />
    <EmbeddedResource Include="StringTableEnglish.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics.Signed" Version="5.0.0" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="System.Collections.Immutable" Version="9.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="6.0.0" />
  </ItemGroup>
  <!--
    Microsoft.VisualStudio.DebuggerVisualizers ships with Visual Studio itself, not as a NuGet package, so
    its location depends on the installed version and edition. This used to be a path hard coded to
    "2022\Community", which silently ties the build to one particular installation. Probe instead:
      1. the Visual Studio we are being built from (VSINSTALLDIR), so the visualizers match the VS that will
         debug them - this is the case when building inside the IDE or from a developer command prompt,
      2. otherwise the installed versions, 2022 before 18 (2026), only because that keeps the resolution the
         command line build had before. Swap the order to prefer the newer one.
    When no Visual Studio is found at all, DebuggerVisualizer.cs is left out of the build: it is a debugging
    aid, nothing else in CADability references those classes.
  -->
  <PropertyGroup>
    <_VsVisualizerDll>Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.DebuggerVisualizers.dll</_VsVisualizerDll>
    <_VsRoot>$(ProgramW6432)\Microsoft Visual Studio</_VsRoot>
    <_VsRoot Condition="'$(ProgramW6432)' == ''">$(ProgramFiles)\Microsoft Visual Studio</_VsRoot>
  </PropertyGroup>
  <PropertyGroup>
    <VsDebuggerVisualizersPath Condition="'$(VSINSTALLDIR)' != '' And Exists('$(VSINSTALLDIR)$(_VsVisualizerDll)')">$(VSINSTALLDIR)$(_VsVisualizerDll)</VsDebuggerVisualizersPath>
    <VsDebuggerVisualizersPath Condition="'$(VsDebuggerVisualizersPath)' == '' And Exists('$(_VsRoot)\2022\Enterprise\$(_VsVisualizerDll)')">$(_VsRoot)\2022\Enterprise\$(_VsVisualizerDll)</VsDebuggerVisualizersPath>
    <VsDebuggerVisualizersPath Condition="'$(VsDebuggerVisualizersPath)' == '' And Exists('$(_VsRoot)\2022\Professional\$(_VsVisualizerDll)')">$(_VsRoot)\2022\Professional\$(_VsVisualizerDll)</VsDebuggerVisualizersPath>
    <VsDebuggerVisualizersPath Condition="'$(VsDebuggerVisualizersPath)' == '' And Exists('$(_VsRoot)\2022\Community\$(_VsVisualizerDll)')">$(_VsRoot)\2022\Community\$(_VsVisualizerDll)</VsDebuggerVisualizersPath>
    <VsDebuggerVisualizersPath Condition="'$(VsDebuggerVisualizersPath)' == '' And Exists('$(_VsRoot)\18\Enterprise\$(_VsVisualizerDll)')">$(_VsRoot)\18\Enterprise\$(_VsVisualizerDll)</VsDebuggerVisualizersPath>
    <VsDebuggerVisualizersPath Condition="'$(VsDebuggerVisualizersPath)' == '' And Exists('$(_VsRoot)\18\Professional\$(_VsVisualizerDll)')">$(_VsRoot)\18\Professional\$(_VsVisualizerDll)</VsDebuggerVisualizersPath>
    <VsDebuggerVisualizersPath Condition="'$(VsDebuggerVisualizersPath)' == '' And Exists('$(_VsRoot)\18\Community\$(_VsVisualizerDll)')">$(_VsRoot)\18\Community\$(_VsVisualizerDll)</VsDebuggerVisualizersPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CADability.DebuggerVisualizers">
      <HintPath>..\CADability.DebuggerVisualizers\bin\Debug\net48\CADability.DebuggerVisualizers.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.DebuggerVisualizers" Condition="'$(VsDebuggerVisualizersPath)' != ''">
      <HintPath>$(VsDebuggerVisualizersPath)</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(VsDebuggerVisualizersPath)' == ''">
    <Compile Remove="DebuggerVisualizer.cs" />
  </ItemGroup>

</Project>
