<Project Sdk="Microsoft.NET.Sdk">
  <!-- References the built CADability.dll instead of the project: a ProjectReference fails in GenerateDepsFile (MSB4018).
       Build CADability in Release first. Copy the output folder before rebuilding CADability to keep a baseline probe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CADability">
      <HintPath>..\..\..\CADability\bin\Release\netstandard2.0\CADability.dll</HintPath>
    </Reference>
    <PackageReference Include="MathNet.Numerics.Signed" Version="5.0.0" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="System.Collections.Immutable" Version="9.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="6.0.0" />
  </ItemGroup>
</Project>
