<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--<Nullable>enable</Nullable>-->
    <UseWindowsForms>true</UseWindowsForms>

    <IsPackable>false</IsPackable>

    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Files\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- These tests target Face.GetSimpleTriangulationCDT / ...RecursiveSplit and
         TriangulationDebugCounters, which only exist in the CDTriangulation prototype
         worktree, not (yet) in this tree. Re-include them once that work is merged. -->
    <Compile Remove="CDTriangulationTests.cs" />
    <Compile Remove="RecursiveSplitDiagnosticTests.cs" />
    <Compile Remove="TriangulationQualityTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Files\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.1.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="2.2.8" />
    <PackageReference Include="MSTest.TestFramework" Version="2.2.8" />
    <PackageReference Include="coverlet.collector" Version="3.1.2" />
    <PackageReference Include="JunitXml.TestLogger" Version="3.0.114" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CADability\CADability.csproj" />
    <ProjectReference Include="..\..\CADability.Forms.NET8\CADability.Forms.NET8.csproj" />
  </ItemGroup>

</Project>
