{
  // Per-case expectations for the BRep regression harness (BRepRegressionTests).
  // A file that is not listed here defaults to status "Ok": it has to follow the marker convention,
  // it has to run and it has to keep matching its baseline.
  //
  //   Ok           must produce a valid result and match the baseline
  //   KnownFail    known to be broken; must still match the baseline. If it succeeds, the test says so
  //                and the case should be promoted to "Ok"
  //   CorruptInput the operands are already inconsistent - an import/authoring bug, not a BRep bug
  //   NeedsFixup   the project file does not follow the marker convention yet (missing Operand1/Operand2
  //                styles or no text object naming the operation)
  //   Skip         deliberately excluded
  // Repeat runs a case more than once inside the same test run and requires every run to produce the same
  // summary. Set it on cases that have been seen to move: without it such a case silently compares one throw
  // of the dice against a baseline that recorded another. An unstable case fails the run and is not
  // regenerated - freezing one of its outcomes would only make the next run look like a regression.
  // RelativeTolerance applies to the floating point values only (volume, area, lengths, coordinates); counts,
  // the Euler characteristic, the surface histogram and the status are always compared exactly.
  // It is 1e-4 rather than tighter because a case was still seen to differ once in five runs. Volume, area
  // and extent used to depend on what ran before in the same process - Face.AssureTriangles(0.0) reuses
  // whatever triangulation exists, however coarse - which is why the summary now asks for an explicit
  // precision (size/1000, see ShellMetrics.PrecisionFor). That removed the effect for the cases we saw.
  // "Repeat" in Defaults is the fallback for cases that do not carry their own. Raising it to 3 repeats
  // every case and turns one run into a stability survey over the whole set - worth doing before a change
  // that is expected to move iteration order (the PowerCollections replacement, for instance), because it
  // separates "this case flickers anyway" from "this change broke it". It multiplies the runtime of the BRep
  // suite, so put it back to 1 afterwards and give the cases that actually moved their own "Repeat".
  "Defaults": {
    "TimeoutSeconds": 120,
    "RelativeTolerance": 1e-4,
    "Repeat": 1
  },

  // The two switches for a manual run - usable from the Visual Studio test explorer, no environment
  // variables needed. Set one, run the tests, set it back.
  //   "Only"       run just this one case, e.g. "UniteBug14". "" = all cases.
  //   "Regenerate" write the baselines from the current behaviour instead of comparing against them.
  //                Only after you judged a difference to be an improvement; review the changed files
  //                under Baselines/ afterwards.
  // As long as either is set, the test BaselineSwitchesAreTurnedOff fails - that is on purpose, so a
  // half finished manual run cannot look green or slip into a commit.
  "Run": {
    "Only": "",
    "Regenerate": false
  },
  "Cases": [
    {
      "Name": "DifferenceBug",
      "Status": "CorruptInput",
      "Comment": "markers were added later, the file is readable now - but Operand2 already fails Shell.CheckConsistency()"
    },
    {
      "Name": "DifferenceBug3",
      "Status": "Ok",
      "Comment": "16 Operand2 solids are subtracted from Operand1, one after the other"
    },
    {
      "Name": "DifferenceBug18",
      "Status": "Ok",
      "Comment": "used to be one solid and one free shell without markers and without a text object"
    },
    {
      "Name": "DifferenceBug20",
      "Status": "Ok",
      "Comment": "added with d99fd343 (the manifold edge fix in BooleanOperation) and correct from the start; checked by GH, see the verified note in its baseline"
    },
    {
      "Name": "UniteBug15",
      "Status": "Ok",
      "Operation": "Union",
      "Comment": "operands are marked, only the text object is missing"
    },

    // --- 2026-09-07: ALL baselines were rewritten, because the counts are no longer taken from the faces as
    //     they happen to be split but from the patches (see readme.md, "Patches"). Old and new counts cannot
    //     be compared, so the rebaseline also swallowed the differences that were open at that moment. They
    //     are written down here instead, measured against the 2026-08-30 baselines under the old metric, and
    //     NONE of them has been judged by hand:
    //
    //       DifferenceBug9    volume 50417.2552869 -> 50409.1487716, area 56629.0629903 -> 56607.5314873
    //       DifferenceBug15   out1 volume 6780.1005555 -> 6785.89055668, area 4750.77126117 -> 4751.42503815
    //       UniteBug4         edges 126 -> 128, vertices 84 -> 85, holeLoops 22 -> 23, euler -20 -> -22
    //       UniteBug5         edges 387 -> 389, vertices 258 -> 259, holeLoops 66 -> 67, euler -64 -> -66
    //       UniteBug6         edges 775 -> 773, vertices 516 -> 515, holeLoops 134 -> 133, euler -134 -> -132,
    //                         volume 3838.21564295 -> 3844.5216561, and in1 volume 3571.62653334 -> 3584.43831996
    //
    //     Two different things are in that list. The volume and area values are a measurement artefact: they
    //     are summed over the triangulation, and Triangulation.cs was replaced by the CDT triangulator in the
    //     meantime, so the same unchanged INPUT measures differently - which is exactly what in1 of UniteBug6
    //     shows, an operand the operation never touched. The euler values are not: euler is read off the
    //     shell as it is and is unaffected by the metric change, so UniteBug4/5/6 really did change genus.
    //
    //     RESOLVED the same day for UniteBug4, UniteBug5 and UniteBug6: GH checked them - the union of
    //     touching cylindrical rings - and the genus change is the consequence of a triangulation bug that
    //     had been fixed a few days before. All three came out identical over 8 repeats inside the suite and
    //     over 8 different hashCode offsets, so their baselines now carry a "verified" note.
    //     STILL OPEN: DifferenceBug9 and DifferenceBug15, where only volume and area moved.

    // --- currently broken (this is why the files exist). The baseline freezes the current behaviour,
    //     so a change shows up either way: a different failure, or - the good case - success.
    {
      "Name": "DifferenceBug9",
      "Status": "Ok",
      "Repeat": 3,
      "Comment": "works since the no-empty-loops fix in BooleanOperation; result not verified by hand yet. Found unstable by the 2026-09-02 survey. Volume and area moved with the CDT triangulation, see the 2026-09-07 note above"
    },
    // DifferenceBug16 and DifferenceBug17 were removed on 2026-09-09: their data is invalid, so what the
    // operation made of them said nothing about the BRep code. Both were "KnownFail" with no resulting shell.
    // The files are in the history (last present in d99fd343) if they are ever wanted back.
    //
    // UniteBug18 explains the other gap in the numbering: deleted in 8c457bf5, and the version the history
    // holds fails on its own input - operand1 does not pass Shell.CheckConsistency() and the union returns no
    // shell. An authoring bug rather than a BRep bug, so there is nothing here worth recording.

    {
      "Name": "UniteBug3",
      "Status": "Ok",
      "Comment": "returned no shell at all until the approxBSpline cache fix in InterpolatedDualSurfaceCurve.Reverse"
    },
    {
      "Name": "UniteBug8",
      "Status": "Ok",
      "Operation": "Union",
      "Comment": "operands are marked, the text object is missing; the Debug.Assert 'loops.Count should never be 0' is gone"
    },
    {
      "Name": "UniteBug9",
      "Status": "Ok",
