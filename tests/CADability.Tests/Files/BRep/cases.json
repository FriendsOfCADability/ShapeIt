{
  // Per-case expectations for the BRep regression harness (BRepRegressionTests).
  // A file that is not listed here defaults to status "Ok": it has to follow the marker convention,
  // it has to run and it has to keep matching its baseline.
  //
  //   Ok           must produce a valid result and match the baseline
  //   KnownFail    known to be broken; must still match the baseline. If it succeeds, the test says so
  //                and the case should be promoted to "Ok"
  //   CorruptInput the operands are already inconsistent - an import/authoring bug, not a BRep bug
  //   NeedsFixup   the project file does not follow the marker convention yet (missing Operand1/Operand2
  //                styles or no text object naming the operation)
  //   Skip         deliberately excluded
  // Repeat runs a case more than once inside the same test run and requires every run to produce the same
  // summary. Set it on cases that have been seen to move: without it such a case silently compares one throw
  // of the dice against a baseline that recorded another. An unstable case fails the run and is not
  // regenerated - freezing one of its outcomes would only make the next run look like a regression.
  // RelativeTolerance applies to the floating point values only (volume, area, lengths, coordinates); counts,
  // the Euler characteristic, the surface histogram and the status are always compared exactly.
  // It is 1e-4 rather than tighter because a case was still seen to differ once in five runs. Volume, area
  // and extent used to depend on what ran before in the same process - Face.AssureTriangles(0.0) reuses
  // whatever triangulation exists, however coarse - which is why the summary now asks for an explicit
  // precision (size/1000, see ShellMetrics.PrecisionFor). That removed the effect for the cases we saw.
  "Defaults": {
    "TimeoutSeconds": 120,
    "RelativeTolerance": 1e-4
  },

  // The two switches for a manual run - usable from the Visual Studio test explorer, no environment
  // variables needed. Set one, run the tests, set it back.
  //   "Only"       run just this one case, e.g. "UniteBug14". "" = all cases.
  //   "Regenerate" write the baselines from the current behaviour instead of comparing against them.
  //                Only after you judged a difference to be an improvement; review the changed files
  //                under Baselines/ afterwards.
  // As long as either is set, the test BaselineSwitchesAreTurnedOff fails - that is on purpose, so a
  // half finished manual run cannot look green or slip into a commit.
  "Run": {
    "Only": "",
    "Regenerate": false
  },
  "Cases": [
    {
      "Name": "DifferenceBug",
      "Status": "CorruptInput",
      "Comment": "markers were added later, the file is readable now - but Operand2 already fails Shell.CheckConsistency()"
    },
    {
      "Name": "DifferenceBug3",
      "Status": "Ok",
      "Comment": "16 Operand2 solids are subtracted from Operand1, one after the other"
    },
    {
      "Name": "DifferenceBug18",
      "Status": "Ok",
      "Comment": "used to be one solid and one free shell without markers and without a text object"
    },
    {
      "Name": "UniteBug15",
      "Status": "Ok",
      "Operation": "Union",
      "Comment": "operands are marked, only the text object is missing"
    },

    // --- currently broken (this is why the files exist). The baseline freezes the current behaviour,
    //     so a change shows up either way: a different failure, or - the good case - success.
    {
      "Name": "DifferenceBug9",
      "Status": "Ok",
      "Comment": "works since the no-empty-loops fix in BooleanOperation; result not verified by hand yet"
    },
    {
      "Name": "DifferenceBug16",
      "Status": "KnownFail",
      "Comment": "runs through but returns no shell at all"
    },
    {
      "Name": "DifferenceBug17",
      "Status": "KnownFail",
      "Comment": "Debug.Assert inside the boolean operation"
    },
    {
      "Name": "UniteBug3",
      "Status": "Ok",
      "Comment": "returned no shell at all until the approxBSpline cache fix in InterpolatedDualSurfaceCurve.Reverse"
    },
    {
      "Name": "UniteBug8",
      "Status": "Ok",
      "Operation": "Union",
      "Comment": "operands are marked, the text object is missing; the Debug.Assert 'loops.Count should never be 0' is gone"
    },
    {
      "Name": "UniteBug9",
      "Status": "Ok",
      "Comment": "works since the no-empty-loops fix in BooleanOperation; result not verified by hand yet"
    },
    {
      "Name": "UniteBug14",
      "Status": "Ok",
      "Comment": "used to throw a NullReferenceException inside the boolean operation"
    },
    {
      "Name": "UniteBug16",
      "Status": "Ok",
      "Comment": "used to hit the Debug.Assert 'loops.Count should never be 0'; the intersection point close to the end of an edge did create a vertex but was not used to split that edge"
    },

    // --- sentinels for reproducibility. These four were caught disagreeing with a baseline that had just been
    //     generated from them, in the same code and on the same machine - only under a different test filter.
    //     "Repeat" turns that into something the suite notices by itself instead of by accident.
    {
      "Name": "UniteBug1",
      "Status": "Ok",
      "Repeat": 3,
      "Comment": "flipped between one valid shell and no shell at all depending on what ran before it"
    },
    {
      "Name": "UniteBug4",
      "Status": "Ok",
      "Repeat": 3,
      "Comment": "edge and holeLoop counts move between runs, same family as UniteBug5/6/7"
    },
    {
      "Name": "UniteBug5",
      "Status": "Ok",
      "Repeat": 3,
      "Comment": "edge and holeLoop counts have been seen to move between runs"
    },
    {
      "Name": "UniteBug6",
      "Status": "Ok",
      "Repeat": 3,
      "Comment": "edge and holeLoop counts and the volume move between runs, same family as UniteBug5/7"
    },
    {
      "Name": "UniteBug7",
      "Status": "Ok",
      "Repeat": 3,
      "Comment": "edge and holeLoop counts and the volume have been seen to move between runs"
    },
    {
      "Name": "DifferenceBug15",
      "Status": "Ok",
      "Repeat": 2,
      "Comment": "volume of the second shell moved by 0.2 percent between runs; only 2 repeats, the case is slow"
    },
    {
      "Name": "UniteBug20",
      "Status": "KnownFail",
      "Comment": "runs through but returns no shell at all; unchanged since the file was added"
    },
    {
      "Name": "UniteBug21",
      "Status": "CorruptInput",
      "Comment": "Operand1 already fails Shell.CheckConsistency(), so the Debug.Assert in the operation is a consequence, not a BRep bug"
    }
  ]
}
