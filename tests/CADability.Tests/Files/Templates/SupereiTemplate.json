{
  "templates": [
    {
      "name": "superEgg",
      "items": [
        {
          "method": "template_begin",
          "id": 14,
          "params": {
            "name": "superEgg",
            "label": "Superei",
            "category": "Freiform",
            "description": "Body with superellipse cross-sections. The bottom (z=0), widest (z=zMid) and top (z=height) sections can be set independently. Each end can be made almost flat, so the body rests nearly flat on its base and ends nearly flat at the top.",
            "tags": [
              "superellipse",
              "egg",
              "parametric surface"
            ],
            "parameters": [
              {
                "name": "widthXBottom",
                "value": 100,
                "label": "Breite X unten",
                "input": {
                  "kind": "length",
                  "group": "Unten",
                  "order": 1,
                  "min": 1
                }
              },
              {
                "name": "widthYBottom",
                "value": 80,
                "label": "Breite Y unten",
                "input": {
                  "kind": "length",
                  "group": "Unten",
                  "order": 2,
                  "min": 1
                }
              },
              {
                "name": "flatBottom",
                "value": 0.5,
                "label": "Flachheit unten",
                "input": {
                  "kind": "length",
                  "group": "Unten",
                  "order": 3,
                  "min": 0.01,
                  "description": "Distance below z=0 at which the wall would become horizontal. Smaller = flatter contact; too small may make the split with the base unreliable."
                }
              },
              {
                "name": "widthXMid",
                "value": 200,
                "label": "Breite X Mitte",
                "input": {
                  "kind": "length",
                  "group": "Mitte",
                  "order": 4,
                  "min": 1
                }
              },
              {
                "name": "widthYMid",
                "value": 160,
                "label": "Breite Y Mitte",
                "input": {
                  "kind": "length",
                  "group": "Mitte",
                  "order": 5,
                  "min": 1
                }
              },
              {
                "name": "zMid",
                "value": 100,
                "label": "H\u00F6he der breitesten Stelle",
                "input": {
                  "kind": "length",
                  "group": "Mitte",
                  "order": 6,
                  "min": 1
                }
              },
              {
                "name": "widthXTop",
                "value": 100,
                "label": "Breite X oben",
                "input": {
                  "kind": "length",
                  "group": "Oben",
                  "order": 7,
                  "min": 1
                }
              },
              {
                "name": "widthYTop",
                "value": 80,
                "label": "Breite Y oben",
                "input": {
                  "kind": "length",
                  "group": "Oben",
                  "order": 8,
                  "min": 1
                }
              },
              {
                "name": "flatTop",
                "value": 0.5,
                "label": "Flachheit oben",
                "input": {
                  "kind": "length",
                  "group": "Oben",
                  "order": 9,
                  "min": 0.01,
                  "description": "Distance above z=height at which the wall would become horizontal. Smaller = flatter end."
                }
              },
              {
                "name": "height",
                "value": 200,
                "label": "Gesamth\u00F6he",
                "input": {
                  "kind": "length",
                  "group": "Allgemein",
                  "order": 10,
                  "min": 2
                }
              },
              {
                "name": "exponent",
                "value": 3,
                "label": "Superellipsen-Exponent",
                "input": {
                  "kind": "number",
                  "group": "Allgemein",
                  "order": 11,
                  "min": 1,
                  "step": 0.5,
                  "description": "2 = ellipse, larger = more rectangular"
                }
              }
            ]
          }
        },
        {
          "method": "surface_parametric",
          "id": 15,
          "params": {
            "name": "eggSurface",
            "approximation": {
              "uParameter": "u",
              "vParameter": "t",
              "uMin": 0,
              "uMax": "2*pi",
              "vMin": "-(zMid\u002BflatBottom)*(asin(zMid/(zMid\u002BflatBottom))\u002Bpi/2)/2",
              "vMax": "(height-zMid\u002BflatTop)*(asin((height-zMid)/(height-zMid\u002BflatTop))\u002Bpi/2)/2",
              "uPeriodic": true,
              "vPeriodic": false,
              "xExpr": "((widthXBottom/2\u002B(widthXTop-widthXBottom)/2*((1\u002Bsign(t))/2))\u002B(widthXMid/2-(widthXBottom/2\u002B(widthXTop-widthXBottom)/2*((1\u002Bsign(t))/2)))*((cos((t/((zMid\u002B(height-2*zMid)*((1\u002Bsign(t))/2))\u002B(flatBottom\u002B(flatTop-flatBottom)*((1\u002Bsign(t))/2)))))-(sqrt((flatBottom\u002B(flatTop-flatBottom)*((1\u002Bsign(t))/2))*(2*(zMid\u002B(height-2*zMid)*((1\u002Bsign(t))/2))\u002B(flatBottom\u002B(flatTop-flatBottom)*((1\u002Bsign(t))/2))))/((zMid\u002B(height-2*zMid)*((1\u002Bsign(t))/2))\u002B(flatBottom\u002B(flatTop-flatBottom)*((1\u002Bsign(t))/2)))))/(1-(sqrt((flatBottom\u002B(flatTop-flatBottom)*((1\u002Bsign(t))/2))*(2*(zMid\u002B(height-2*zMid)*((1\u002Bsign(t))/2))\u002B(flatBottom\u002B(flatTop-flatBottom)*((1\u002Bsign(t))/2))))/((zMid\u002B(height-2*zMid)*((1\u002Bsign(t))/2))\u002B(flatBottom\u002B(flatTop-flatBottom)*((1\u002Bsign(t))/2)))))))*cos(u)/pow(pow(abs(cos(u)),exponent)\u002Bpow(abs(sin(u)),exponent),1/exponent)",
              "yExpr": "((widthYBottom/2\u002B(widthYTop-widthYBottom)/2*((1\u002Bsign(t))/2))\u002B(widthYMid/2-(widthYBottom/2\u002B(widthYTop-widthYBottom)/2*((1\u002Bsign(t))/2)))*((cos((t/((zMid\u002B(height-2*zMid)*((1\u002Bsign(t))/2))\u002B(flatBottom\u002B(flatTop-flatBottom)*((1\u002Bsign(t))/2)))))-(sqrt((flatBottom\u002B(flatTop-flatBottom)*((1\u002Bsign(t))/2))*(2*(zMid\u002B(height-2*zMid)*((1\u002Bsign(t))/2))\u002B(flatBottom\u002B(flatTop-flatBottom)*((1\u002Bsign(t))/2))))/((zMid\u002B(height-2*zMid)*((1\u002Bsign(t))/2))\u002B(flatBottom\u002B(flatTop-flatBottom)*((1\u002Bsign(t))/2)))))/(1-(sqrt((flatBottom\u002B(flatTop-flatBottom)*((1\u002Bsign(t))/2))*(2*(zMid\u002B(height-2*zMid)*((1\u002Bsign(t))/2))\u002B(flatBottom\u002B(flatTop-flatBottom)*((1\u002Bsign(t))/2))))/((zMid\u002B(height-2*zMid)*((1\u002Bsign(t))/2))\u002B(flatBottom\u002B(flatTop-flatBottom)*((1\u002Bsign(t))/2)))))))*sin(u)/pow(pow(abs(cos(u)),exponent)\u002Bpow(abs(sin(u)),exponent),1/exponent)",
              "zExpr": "zMid\u002B((zMid\u002B(height-2*zMid)*((1\u002Bsign(t))/2))\u002B(flatBottom\u002B(flatTop-flatBottom)*((1\u002Bsign(t))/2)))*sin((t/((zMid\u002B(height-2*zMid)*((1\u002Bsign(t))/2))\u002B(flatBottom\u002B(flatTop-flatBottom)*((1\u002Bsign(t))/2)))))",
              "tolerance": 0.05,
              "minSamplesU": 24,
              "minSamplesV": 16,
              "maxSamplesU": 100,
              "maxSamplesV": 100,
              "sampling": "adaptive"
            }
          }
        },
        {
          "method": "solid_box",
          "id": 16,
          "params": {
            "name": "eggBlock",
            "origin": [
              "-(max(max(widthXBottom,widthXMid),widthXTop)/2\u002B20)",
              "-(max(max(widthYBottom,widthYMid),widthYTop)/2\u002B20)",
              0
            ],
            "sizeX": "max(max(widthXBottom,widthXMid),widthXTop)\u002B40",
            "sizeY": "max(max(widthYBottom,widthYMid),widthYTop)\u002B40",
            "sizeZ": "height"
          }
        },
        {
          "method": "feature_split",
          "id": 17,
          "params": {
            "solid": "eggBlock",
            "splitBy": "eggSurface",
            "nameInner": "egg"
          }
        },
        {
          "method": "template_commit",
          "id": 18,
          "params": {
            "result": "egg"
          }
        }
      ]
    },
    {
      "name": "lampShade",
      "items": [
        {
          "method": "template_begin",
          "id": 38,
          "params": {
            "name": "lampShade",
            "label": "Lampenschirm (Superei)",
