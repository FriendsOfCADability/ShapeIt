        {
          "method": "rpc.batch",
          "id": 3,
          "params": {
            "repeat": {
              "variable": "corner",
              "start": 0,
              "step": 1,
              "count": 4
            },
            "calls": [
              {
                "jsonrpc": "2.0",
                "id": 1,
                "method": "workspace.set",
                "when": "bosses == \"corners\"",
                "params": {
                  "name": "sx",
                  "value": "sqrt(2)*cos(pi/4 + corner*pi/2)"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 2,
                "method": "workspace.set",
                "when": "bosses == \"corners\"",
                "params": {
                  "name": "sy",
                  "value": "sqrt(2)*sin(pi/4 + corner*pi/2)"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 3,
                "method": "sketch.create",
                "when": "bosses == \"corners\"",
                "params": {
                  "plane": {
                    "origin": "center",
                    "xAxis": [
                      1,
                      0,
                      0
                    ],
                    "normal": [
                      0,
                      0,
                      1
                    ]
                  },
                  "name": "bossSketch"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 4,
                "method": "sketch.add_polycurve",
                "when": "bosses == \"corners\"",
                "params": {
                  "sketch": "bossSketch",
                  "isClosed": true,
                  "vertices": [
                    {
                      "x": "sx*(a + t)",
                      "y": "sy*(c + t)",
                      "b": 0
                    },
                    {
                      "x": "sx*ux",
                      "y": "sy*(c + t)",
                      "b": 0
                    },
                    {
                      "x": "sx*ux",
                      "y": "sy*(uy + rb)",
                      "b": "k*sx*sy"
                    },
                    {
                      "x": "sx*(ux - rb)",
                      "y": "sy*uy",
                      "b": "k*sx*sy"
                    },
                    {
                      "x": "sx*ux",
                      "y": "sy*(uy - rb)",
                      "b": "k*sx*sy"
                    },
                    {
                      "x": "sx*(ux + rb)",
                      "y": "sy*uy",
                      "b": 0
                    },
                    {
                      "x": "sx*(a + t)",
                      "y": "sy*uy",
                      "b": 0
                    }
                  ]
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 5,
                "method": "solid.extrude",
                "when": "bosses == \"corners\"",
                "params": {
                  "profile": "bossSketch",
                  "length": "bossTop",
                  "direction": [
                    0,
                    0,
                    1
                  ],
                  "name": "bossTool"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 6,
                "method": "solid.boolean",
                "when": "bosses == \"corners\"",
                "params": {
                  "op": "difference",
                  "a": "cavity",
                  "b": "bossTool",
                  "name": "cavity"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 7,
                "method": "solid.cylinder",
                "when": "bosses == \"corners\"",
                "params": {
                  "start": "center + v(sx*ux, sy*uy, H - bossInset - holeDepth)",
                  "end": "center + v(sx*ux, sy*uy, H + 2*t)",
                  "radius": "dHole/2",
                  "name": "holeTool"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 8,
                "method": "solid.boolean",
                "when": "bosses == \"corners\"",
                "params": {
                  "op": "union",
                  "a": "cavity",
                  "b": "holeTool",
                  "name": "cavity"
                }
              }
            ]
          }
