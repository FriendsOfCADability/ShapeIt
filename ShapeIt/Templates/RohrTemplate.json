{
  "label": "Pipes",
  "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><path d=\"M4 18H20L40 26H60V46H40L20 50H4Z\" fill=\"#c9d6e6\" stroke=\"#494c4e\" stroke-width=\"3\" stroke-linejoin=\"round\"/><ellipse cx=\"4\" cy=\"34\" rx=\"3\" ry=\"16\" fill=\"#ffffff\" stroke=\"#494c4e\" stroke-width=\"3\"/><path d=\"M20 18V50M40 26V46\" fill=\"none\" stroke=\"#494c4e\" stroke-width=\"1.5\"/></svg>",
  "templates": [
    {
      "name": "rohradapter",
      "items": [
        {
          "method": "template.begin",
          "id": 1,
          "params": {
            "name": "rohradapter",
            "label": "Pipe adapter",
            "category": "Pipes",
            "description": "Adapter between two pipes of different diameters: a straight stub of the first pipe, a transition and a straight stub of the second pipe, open at both ends. Diameters and positions of the pipes are given by two circles in one plane; the pipes need not be concentric (eccentric reducer). The first pipe ends in the plane of the circles, the transition runs along the normal of the first circle, the second pipe starts at the transition length from that plane. The transition is a ruled surface which connects the two circles point by point (an oblique cone). The circles are either the outer or the inner diameters. The wall thickness of the transition is measured in the planes of the circles (always possible, the wall gets thinner where the transition is inclined) or perpendicular to the wall (the same thickness everywhere, only for concentric pipes).",
            "tags": [
              "pipe",
              "tube",
              "adapter",
              "reducer",
              "eccentric reducer",
              "Rohr",
              "Reduzierstück",
              "Übergangsstück",
              "Adapter"
            ],
            "parameters": [
              {
                "name": "c1",
                "value": null,
                "label": "First pipe",
                "input": {
                  "kind": "curve",
                  "group": "Pipes",
                  "order": 1,
                  "description": "Circle giving diameter and position of the first pipe. Both circles lie in one plane, the first pipe ends in this plane, the second pipe is shifted by the transition length along the normal of the first circle (for a circle drawn counterclockwise in the x/y plane: +z). The pipes need not be concentric."
                }
              },
              {
                "name": "c2",
                "value": null,
                "label": "Second pipe",
                "input": {
                  "kind": "curve",
                  "group": "Pipes",
                  "order": 2,
                  "description": "Circle giving diameter and position of the second pipe, in the plane of the first circle. Seen along the axis, the second pipe lies where this circle is."
                }
              },
              {
                "name": "diameter",
                "value": "outer",
                "label": "Circles are",
                "input": {
                  "kind": "enum",
                  "group": "Pipes",
                  "order": 3,
                  "options": [
                    {
                      "value": "outer",
                      "label": "outer diameters"
                    },
                    {
                      "value": "inner",
                      "label": "inner diameters"
                    }
                  ],
                  "description": "Whether the circles are the outer diameters (the wall goes inward) or the inner diameters (the wall goes outward)."
                }
              },
              {
                "name": "L1",
                "value": 30,
                "label": "Length of the first stub",
                "input": {
                  "kind": "length",
                  "group": "Lengths",
                  "order": 4,
                  "min": 0.01,
                  "description": "Length of the straight stub of the first pipe, from its open end to the start of the transition."
                }
              },
              {
                "name": "Lt",
                "value": 40,
                "label": "Transition length",
                "input": {
                  "kind": "length",
                  "group": "Lengths",
                  "order": 5,
                  "min": 0.01,
                  "description": "Length of the transition along the axis, between the two straight stubs."
                }
              },
              {
                "name": "L2",
                "value": 30,
                "label": "Length of the second stub",
                "input": {
                  "kind": "length",
                  "group": "Lengths",
                  "order": 6,
                  "min": 0.01,
                  "description": "Length of the straight stub of the second pipe, from the end of the transition to its open end."
                }
              },
              {
                "name": "t",
                "value": 2,
                "label": "Wall thickness",
                "input": {
                  "kind": "length",
                  "group": "Wall",
                  "order": 7,
                  "min": 0.01,
                  "description": "Wall thickness of the stubs and of the transition; how it is measured in the transition is set by 'Wall thickness measured'."
                }
              },
              {
                "name": "wall",
                "value": "planes",
                "label": "Wall thickness measured",
                "input": {
                  "kind": "enum",
                  "group": "Wall",
                  "order": 8,
                  "options": [
                    {
                      "value": "planes",
                      "label": "in the planes of the circles"
                    },
                    {
                      "value": "perpendicular",
                      "label": "perpendicular to the wall"
                    }
                  ],
                  "description": "In the planes of the circles: the other side of the transition is again a ruled surface between two circles, larger or smaller by the wall thickness; where the transition is inclined, the wall there is thinner than the wall thickness. Perpendicular to the wall: the wall has the same thickness everywhere, where it bends towards the other side, that side is rounded with the wall thickness as radius. Perpendicular is only possible for concentric pipes."
                }
              }
            ],
            "checks": [
              {
                "condition": "type(c1) == \"Ellipse\" && type(c2) == \"Ellipse\"",
                "parameters": [
                  "c1",
                  "c2"
                ],
                "message": "Both pipes must be given by circles."
              },
              {
                "condition": "c1.IsCircle && !c1.IsArc && c2.IsCircle && !c2.IsArc",
                "parameters": [
                  "c1",
                  "c2"
                ],
                "message": "Both pipes must be given by full circles, not by ellipses or arcs."
              },
              {
                "condition": "abs(normalize(c1.Normal) * normalize(c2.Normal)) > 0.999999999 && abs((c2.Center - c1.Center) * normalize(c1.Normal)) < 0.000001 * (c1.Radius + c2.Radius)",
                "parameters": [
                  "c1",
                  "c2"
                ],
                "message": "The two circles must lie in one plane."
              },
              {
                "condition": "diameter == \"inner\" || (t < c1.Radius && t < c2.Radius)",
                "parameters": [
                  "t",
                  "c1",
                  "c2",
                  "diameter"
                ],
                "message": "With outer diameters the wall thickness ({t}) must be smaller than the radius of both circles ({c1.Radius}, {c2.Radius})."
              },
              {
                "condition": "wall == \"planes\" || distance(c1.Center, c2.Center) < 0.000001 * (c1.Radius + c2.Radius)",
                "parameters": [
                  "wall",
                  "c1",
                  "c2"
                ],
                "message": "The wall thickness can only be measured perpendicular to the wall for concentric pipes, the centers of the circles are {distance(c1.Center, c2.Center)} apart. Measure it in the planes of the circles."
              }
            ],
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><path d=\"M4 18H20L40 26H60V46H40L20 50H4Z\" fill=\"#c9d6e6\" stroke=\"#494c4e\" stroke-width=\"3\" stroke-linejoin=\"round\"/><ellipse cx=\"4\" cy=\"34\" rx=\"3\" ry=\"16\" fill=\"#ffffff\" stroke=\"#494c4e\" stroke-width=\"3\"/><path d=\"M20 18V50M40 26V46\" fill=\"none\" stroke=\"#494c4e\" stroke-width=\"1.5\"/></svg>"
          }
        },
        {
          "method": "rpc.batch",
          "id": 2,
          "params": {
            "calls": [
              {
                "jsonrpc": "2.0",
                "id": 1,
                "method": "workspace.set",
                "params": {
                  "name": "n",
                  "value": "normalize(c1.Normal)"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 2,
                "method": "workspace.set",
                "params": {
                  "name": "xd",
                  "value": "normalize(c1.Plane.DirectionX)"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 3,
                "method": "workspace.set",
                "params": {
                  "name": "A",
                  "value": "c1.Center"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 4,
                "method": "workspace.set",
                "params": {
                  "name": "B",
                  "value": "c2.Center + Lt*n"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 5,
                "method": "workspace.set",
                "when": "diameter == \"outer\"",
                "params": {
                  "name": "ro1",
                  "value": "c1.Radius"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 6,
                "method": "workspace.set",
                "when": "diameter == \"outer\"",
                "params": {
                  "name": "ro2",
                  "value": "c2.Radius"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 7,
                "method": "workspace.set",
                "when": "diameter == \"outer\"",
                "params": {
                  "name": "rc1",
                  "value": "c1.Radius - t"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 8,
                "method": "workspace.set",
                "when": "diameter == \"outer\"",
                "params": {
                  "name": "rc2",
                  "value": "c2.Radius - t"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 9,
                "method": "workspace.set",
                "when": "diameter == \"inner\"",
                "params": {
                  "name": "ro1",
                  "value": "c1.Radius + t"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 10,
                "method": "workspace.set",
                "when": "diameter == \"inner\"",
                "params": {
                  "name": "ro2",
                  "value": "c2.Radius + t"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 11,
                "method": "workspace.set",
                "when": "diameter == \"inner\"",
                "params": {
                  "name": "rc1",
                  "value": "c1.Radius"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 12,
                "method": "workspace.set",
                "when": "diameter == \"inner\"",
                "params": {
                  "name": "rc2",
                  "value": "c2.Radius"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 13,
                "method": "sketch.create",
                "when": "diameter == \"outer\" || wall == \"planes\"",
                "params": {
                  "plane": {
                    "origin": "A",
                    "xAxis": "xd",
                    "normal": "n"
                  },
                  "name": "outsideStart"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 14,
                "method": "sketch.add_circle",
                "when": "diameter == \"outer\" || wall == \"planes\"",
                "params": {
                  "sketch": "outsideStart",
                  "center": [
                    0,
                    0
                  ],
                  "radius": "ro1"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 15,
                "method": "sketch.create",
                "when": "diameter == \"outer\" || wall == \"planes\"",
                "params": {
                  "plane": {
                    "origin": "B",
                    "xAxis": "xd",
                    "normal": "n"
                  },
                  "name": "outsideEnd"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 16,
                "method": "sketch.add_circle",
                "when": "diameter == \"outer\" || wall == \"planes\"",
                "params": {
                  "sketch": "outsideEnd",
                  "center": [
                    0,
                    0
                  ],
                  "radius": "ro2"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 17,
                "method": "solid.ruled",
                "when": "diameter == \"outer\" || wall == \"planes\"",
                "params": {
                  "profile1": "outsideStart",
                  "profile2": "outsideEnd",
                  "name": "outside"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 18,
                "method": "solid.cylinder",
                "when": "diameter == \"outer\" || wall == \"planes\"",
                "params": {
                  "start": "A - (L1 + 0)*n",
                  "end": "A",
                  "radius": "ro1",
                  "name": "outsideStub1"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 19,
                "method": "solid.cylinder",
                "when": "diameter == \"outer\" || wall == \"planes\"",
                "params": {
                  "start": "B",
                  "end": "B + (L2 + 0)*n",
                  "radius": "ro2",
                  "name": "outsideStub2"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 20,
                "method": "solid.boolean",
                "when": "diameter == \"outer\" || wall == \"planes\"",
                "params": {
                  "op": "union",
                  "a": "outside",
                  "b": "outsideStub1",
                  "name": "outside"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 21,
                "method": "solid.boolean",
                "when": "diameter == \"outer\" || wall == \"planes\"",
                "params": {
                  "op": "union",
                  "a": "outside",
                  "b": "outsideStub2",
                  "name": "outside"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 22,
                "method": "sketch.create",
                "when": "diameter == \"inner\" || wall == \"planes\"",
                "params": {
                  "plane": {
                    "origin": "A",
                    "xAxis": "xd",
                    "normal": "n"
                  },
                  "name": "cavityStart"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 23,
                "method": "sketch.add_circle",
                "when": "diameter == \"inner\" || wall == \"planes\"",
                "params": {
                  "sketch": "cavityStart",
                  "center": [
                    0,
                    0
                  ],
                  "radius": "rc1"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 24,
                "method": "sketch.create",
                "when": "diameter == \"inner\" || wall == \"planes\"",
                "params": {
                  "plane": {
                    "origin": "B",
                    "xAxis": "xd",
                    "normal": "n"
                  },
                  "name": "cavityEnd"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 25,
                "method": "sketch.add_circle",
                "when": "diameter == \"inner\" || wall == \"planes\"",
                "params": {
                  "sketch": "cavityEnd",
                  "center": [
                    0,
                    0
                  ],
                  "radius": "rc2"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 26,
                "method": "solid.ruled",
                "when": "diameter == \"inner\" || wall == \"planes\"",
                "params": {
                  "profile1": "cavityStart",
                  "profile2": "cavityEnd",
                  "name": "cavity"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 27,
                "method": "solid.cylinder",
                "when": "diameter == \"inner\" || wall == \"planes\"",
                "params": {
                  "start": "A - (L1 + t)*n",
                  "end": "A",
                  "radius": "rc1",
                  "name": "cavityStub1"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 28,
                "method": "solid.cylinder",
                "when": "diameter == \"inner\" || wall == \"planes\"",
                "params": {
                  "start": "B",
                  "end": "B + (L2 + t)*n",
                  "radius": "rc2",
                  "name": "cavityStub2"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 29,
                "method": "solid.boolean",
                "when": "diameter == \"inner\" || wall == \"planes\"",
                "params": {
                  "op": "union",
                  "a": "cavity",
                  "b": "cavityStub1",
                  "name": "cavity"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 30,
                "method": "solid.boolean",
                "when": "diameter == \"inner\" || wall == \"planes\"",
                "params": {
                  "op": "union",
                  "a": "cavity",
                  "b": "cavityStub2",
                  "name": "cavity"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 31,
                "method": "solid.boolean",
                "when": "wall == \"planes\"",
                "params": {
                  "op": "difference",
                  "a": "outside",
                  "b": "cavity",
                  "name": "pipe"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 32,
                "method": "workspace.select",
                "when": "wall == \"perpendicular\" && diameter == \"outer\"",
                "params": {
                  "selector": {
                    "query": {
                      "target": "faces",
                      "from": "outside",
                      "filter": {
                        "condition": "this.SurfaceType == \"planar\""
                      }
                    }
                  },
                  "name": "ends"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 33,
                "method": "solid.hollow",
                "when": "wall == \"perpendicular\" && diameter == \"outer\"",
                "params": {
                  "solid": "outside",
                  "openFaces": "ends",
                  "thickness": "t",
                  "name": "pipe"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 34,
                "method": "solid.offset",
                "when": "wall == \"perpendicular\" && diameter == \"inner\"",
                "params": {
                  "solid": "cavity",
                  "distance": "t",
                  "name": "outside"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 35,
                "method": "solid.cylinder",
                "when": "wall == \"perpendicular\" && diameter == \"inner\"",
                "params": {
                  "start": "A - L1*n",
                  "end": "A + (Lt + L2)*n",
                  "radius": "distance(c1.Center, c2.Center) + c1.Radius + c2.Radius + 2*t",
                  "name": "clip"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 36,
                "method": "solid.boolean",
                "when": "wall == \"perpendicular\" && diameter == \"inner\"",
                "params": {
                  "op": "intersect",
                  "a": "outside",
                  "b": "clip",
                  "name": "outside"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 37,
                "method": "solid.boolean",
                "when": "wall == \"perpendicular\" && diameter == \"inner\"",
                "params": {
                  "op": "difference",
                  "a": "outside",
                  "b": "cavity",
                  "name": "pipe"
                }
              }
            ]
          }
        },
        {
          "method": "template.commit",
          "id": 3,
          "params": {
            "result": "pipe"
          }
        }
      ]
    }
  ],
  "translations": {
    "de": {
      "label": "Rohre",
      "templates": {
        "rohradapter": {
          "label": "Rohradapter",
          "category": "Rohre",
          "description": "Adapter zwischen zwei Rohren unterschiedlichen Durchmessers: ein gerader Stutzen des ersten Rohrs, ein Übergang und ein gerader Stutzen des zweiten Rohrs, an beiden Enden offen. Durchmesser und Lage der Rohre werden durch zwei Kreise in einer Ebene angegeben; die Rohre müssen nicht konzentrisch sein (exzentrisches Reduzierstück). Das erste Rohr endet in der Ebene der Kreise, der Übergang verläuft entlang der Normalen des ersten Kreises, das zweite Rohr beginnt im Abstand der Übergangslänge von dieser Ebene. Der Übergang ist eine Regelfläche, die die beiden Kreise Punkt für Punkt verbindet (ein schiefer Kegel). Die Kreise sind entweder die Außen- oder die Innendurchmesser. Die Wandstärke des Übergangs wird in den Ebenen der Kreise gemessen (immer möglich, wo der Übergang schräg ist, wird die Wand dünner) oder senkrecht zur Wand (überall gleich dick, nur bei konzentrischen Rohren).",
          "parameters": {
            "c1": {
              "label": "Erstes Rohr",
              "group": "Rohre",
              "description": "Kreis, der Durchmesser und Lage des ersten Rohrs angibt. Beide Kreise liegen in einer Ebene, das erste Rohr endet in dieser Ebene, das zweite ist um die Übergangslänge entlang der Normalen des ersten Kreises verschoben (bei einem in der x/y-Ebene gegen den Uhrzeigersinn gezeichneten Kreis: +z). Die Rohre müssen nicht konzentrisch sein."
            },
            "c2": {
              "label": "Zweites Rohr",
              "group": "Rohre",
              "description": "Kreis, der Durchmesser und Lage des zweiten Rohrs angibt, in der Ebene des ersten Kreises. In Achsrichtung gesehen liegt das zweite Rohr dort, wo dieser Kreis ist."
            },
            "diameter": {
              "label": "Die Kreise sind",
              "group": "Rohre",
              "description": "Ob die Kreise die Außendurchmesser sind (die Wand geht nach innen) oder die Innendurchmesser (die Wand geht nach außen).",
              "options": {
                "outer": "Außendurchmesser",
                "inner": "Innendurchmesser"
              }
            },
            "L1": {
              "label": "Länge des ersten Stutzens",
              "group": "Längen",
              "description": "Länge des geraden Stutzens des ersten Rohrs, vom offenen Ende bis zum Beginn des Übergangs."
            },
            "Lt": {
              "label": "Übergangslänge",
              "group": "Längen",
              "description": "Länge des Übergangs in Achsrichtung, zwischen den beiden geraden Stutzen."
            },
            "L2": {
              "label": "Länge des zweiten Stutzens",
              "group": "Längen",
              "description": "Länge des geraden Stutzens des zweiten Rohrs, vom Ende des Übergangs bis zum offenen Ende."
            },
            "t": {
              "label": "Wandstärke",
              "group": "Wand",
              "description": "Wandstärke der Stutzen und des Übergangs; wie sie im Übergang gemessen wird, legt „Wandstärke gemessen“ fest."
            },
            "wall": {
              "label": "Wandstärke gemessen",
              "group": "Wand",
              "description": "In den Ebenen der Kreise: Die andere Seite des Übergangs ist wieder eine Regelfläche zwischen zwei Kreisen, die um die Wandstärke größer bzw. kleiner sind; wo der Übergang schräg ist, ist die Wand dort dünner als die Wandstärke. Senkrecht zur Wand: Die Wand ist überall gleich dick, wo sie zur anderen Seite hin knickt, wird diese mit der Wandstärke als Radius gerundet. Senkrecht ist nur bei konzentrischen Rohren möglich.",
              "options": {
                "planes": "in den Ebenen der Kreise",
                "perpendicular": "senkrecht zur Wand"
              }
            }
          },
          "checks": [
            "Beide Rohre müssen durch Kreise angegeben werden.",
            "Beide Rohre müssen durch Vollkreise angegeben werden, nicht durch Ellipsen oder Bögen.",
            "Die beiden Kreise müssen in einer Ebene liegen.",
            "Bei Außendurchmessern muss die Wandstärke ({t}) kleiner sein als der Radius beider Kreise ({c1.Radius}, {c2.Radius}).",
            "Die Wandstärke kann nur bei konzentrischen Rohren senkrecht zur Wand gemessen werden, die Mittelpunkte der Kreise liegen {distance(c1.Center, c2.Center)} auseinander. Bitte in den Ebenen der Kreise messen."
          ]
        }
      }
    }
  }
}
