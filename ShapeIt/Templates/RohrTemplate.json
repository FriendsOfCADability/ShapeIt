{
  "label": "Pipes",
  "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><path d=\"M4 18H20L40 26H60V46H40L20 50H4Z\" fill=\"#c9d6e6\" stroke=\"#494c4e\" stroke-width=\"3\" stroke-linejoin=\"round\"/><ellipse cx=\"4\" cy=\"34\" rx=\"3\" ry=\"16\" fill=\"#ffffff\" stroke=\"#494c4e\" stroke-width=\"3\"/><path d=\"M20 18V50M40 26V46\" fill=\"none\" stroke=\"#494c4e\" stroke-width=\"1.5\"/></svg>",
  "templates": [
    {
      "name": "rohradapter",
      "items": [
        {
          "method": "template.begin",
          "id": 1,
          "params": {
            "name": "rohradapter",
            "label": "Pipe adapter",
            "category": "Pipes",
            "description": "Adapter between two pipes of different diameters: a straight stub of the first pipe, a transition and a straight stub of the second pipe, open at both ends. Diameters and positions of the pipes are given by two circles in one plane; the pipes need not be concentric (eccentric reducer). The first pipe ends in the plane of the circles, the transition runs along the normal of the first circle, the second pipe starts at the transition length from that plane. The transition is a ruled surface which connects the two circles point by point (an oblique cone). The circles are either the outer or the inner diameters. The wall has the same thickness everywhere, measured perpendicular to the wall, in the transition as well: with outer diameters the solid outer shape is hollowed out, with inner diameters the outer shape is the offset of the inside.",
            "tags": [
              "pipe",
              "tube",
              "adapter",
              "reducer",
              "eccentric reducer",
              "Rohr",
              "Reduzierstück",
              "Übergangsstück",
              "Adapter"
            ],
            "parameters": [
              {
                "name": "c1",
                "value": null,
                "label": "First pipe",
                "input": {
                  "kind": "curve",
                  "group": "Pipes",
                  "order": 1,
                  "description": "Circle giving diameter and position of the first pipe. Both circles lie in one plane, the first pipe ends in this plane, the second pipe is shifted by the transition length along the normal of the first circle (for a circle drawn counterclockwise in the x/y plane: +z). The pipes need not be concentric."
                }
              },
              {
                "name": "c2",
                "value": null,
                "label": "Second pipe",
                "input": {
                  "kind": "curve",
                  "group": "Pipes",
                  "order": 2,
                  "description": "Circle giving diameter and position of the second pipe, in the plane of the first circle. Seen along the axis, the second pipe lies where this circle is."
                }
              },
              {
                "name": "diameter",
                "value": "outer",
                "label": "Circles are",
                "input": {
                  "kind": "enum",
                  "group": "Pipes",
                  "order": 3,
                  "options": [
                    {
                      "value": "outer",
                      "label": "outer diameters"
                    },
                    {
                      "value": "inner",
                      "label": "inner diameters"
                    }
                  ],
                  "description": "Whether the circles are the outer diameters (the wall goes inward) or the inner diameters (the wall goes outward)."
                }
              },
              {
                "name": "L1",
                "value": 30,
                "label": "Length of the first stub",
                "input": {
                  "kind": "length",
                  "group": "Lengths",
                  "order": 4,
                  "min": 0.01,
                  "description": "Length of the straight stub of the first pipe, from its open end to the start of the transition."
                }
              },
              {
                "name": "Lt",
                "value": 40,
                "label": "Transition length",
                "input": {
                  "kind": "length",
                  "group": "Lengths",
                  "order": 5,
                  "min": 0.01,
                  "description": "Length of the transition along the axis, between the two straight stubs."
                }
              },
              {
                "name": "L2",
                "value": 30,
                "label": "Length of the second stub",
                "input": {
                  "kind": "length",
                  "group": "Lengths",
                  "order": 6,
                  "min": 0.01,
                  "description": "Length of the straight stub of the second pipe, from the end of the transition to its open end."
                }
              },
              {
                "name": "t",
                "value": 2,
                "label": "Wall thickness",
                "input": {
                  "kind": "length",
                  "group": "Wall",
                  "order": 7,
                  "min": 0.01,
                  "description": "Wall thickness, measured perpendicular to the wall, in the transition as well. Where the wall bends towards the inside, the inside of the bend is rounded with the wall thickness as radius, so that the wall keeps its thickness there."
                }
              }
            ],
            "checks": [
              {
                "condition": "type(c1) == \"Ellipse\" && type(c2) == \"Ellipse\"",
                "parameters": [
                  "c1",
                  "c2"
                ],
                "message": "Both pipes must be given by circles."
              },
              {
                "condition": "c1.IsCircle && !c1.IsArc && c2.IsCircle && !c2.IsArc",
                "parameters": [
                  "c1",
                  "c2"
                ],
                "message": "Both pipes must be given by full circles, not by ellipses or arcs."
              },
              {
                "condition": "abs(normalize(c1.Normal) * normalize(c2.Normal)) > 0.999999999 && abs((c2.Center - c1.Center) * normalize(c1.Normal)) < 0.000001 * (c1.Radius + c2.Radius)",
                "parameters": [
                  "c1",
                  "c2"
                ],
                "message": "The two circles must lie in one plane."
              },
              {
                "condition": "diameter == \"inner\" || (t < c1.Radius && t < c2.Radius)",
                "parameters": [
                  "t",
                  "c1",
                  "c2",
                  "diameter"
                ],
                "message": "With outer diameters the wall thickness ({t}) must be smaller than the radius of both circles ({c1.Radius}, {c2.Radius})."
              }
            ],
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><path d=\"M4 18H20L40 26H60V46H40L20 50H4Z\" fill=\"#c9d6e6\" stroke=\"#494c4e\" stroke-width=\"3\" stroke-linejoin=\"round\"/><ellipse cx=\"4\" cy=\"34\" rx=\"3\" ry=\"16\" fill=\"#ffffff\" stroke=\"#494c4e\" stroke-width=\"3\"/><path d=\"M20 18V50M40 26V46\" fill=\"none\" stroke=\"#494c4e\" stroke-width=\"1.5\"/></svg>"
          }
        },
        {
          "method": "rpc.batch",
          "id": 2,
          "params": {
            "calls": [
              {
                "jsonrpc": "2.0",
                "id": 1,
                "method": "workspace.set",
                "params": {
                  "name": "n",
                  "value": "normalize(c1.Normal)"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 2,
                "method": "workspace.set",
                "params": {
                  "name": "xd",
                  "value": "normalize(c1.Plane.DirectionX)"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 3,
                "method": "workspace.set",
                "params": {
                  "name": "A",
                  "value": "c1.Center"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 4,
                "method": "workspace.set",
                "params": {
                  "name": "B",
                  "value": "c2.Center + Lt*n"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 5,
                "method": "sketch.create",
                "when": "diameter == \"outer\"",
                "params": {
                  "plane": {
                    "origin": "A",
                    "xAxis": "xd",
                    "normal": "n"
                  },
                  "name": "outsideStart"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 6,
                "method": "sketch.add_circle",
                "when": "diameter == \"outer\"",
                "params": {
                  "sketch": "outsideStart",
                  "center": [
                    0,
                    0
                  ],
                  "radius": "c1.Radius"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 7,
                "method": "sketch.create",
                "when": "diameter == \"outer\"",
                "params": {
                  "plane": {
                    "origin": "B",
                    "xAxis": "xd",
                    "normal": "n"
                  },
                  "name": "outsideEnd"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 8,
                "method": "sketch.add_circle",
                "when": "diameter == \"outer\"",
                "params": {
                  "sketch": "outsideEnd",
                  "center": [
                    0,
                    0
                  ],
                  "radius": "c2.Radius"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 9,
                "method": "solid.ruled",
                "when": "diameter == \"outer\"",
                "params": {
                  "profile1": "outsideStart",
                  "profile2": "outsideEnd",
                  "name": "outside"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 10,
                "method": "solid.cylinder",
                "when": "diameter == \"outer\"",
                "params": {
                  "start": "A - (L1 + 0)*n",
                  "end": "A",
                  "radius": "c1.Radius",
                  "name": "outsideStub1"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 11,
                "method": "solid.cylinder",
                "when": "diameter == \"outer\"",
                "params": {
                  "start": "B",
                  "end": "B + (L2 + 0)*n",
                  "radius": "c2.Radius",
                  "name": "outsideStub2"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 12,
                "method": "solid.boolean",
                "when": "diameter == \"outer\"",
                "params": {
                  "op": "union",
                  "a": "outside",
                  "b": "outsideStub1",
                  "name": "outside"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 13,
                "method": "solid.boolean",
                "when": "diameter == \"outer\"",
                "params": {
                  "op": "union",
                  "a": "outside",
                  "b": "outsideStub2",
                  "name": "outside"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 14,
                "method": "sketch.create",
                "when": "diameter == \"inner\"",
                "params": {
                  "plane": {
                    "origin": "A",
                    "xAxis": "xd",
                    "normal": "n"
                  },
                  "name": "insideStart"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 15,
                "method": "sketch.add_circle",
                "when": "diameter == \"inner\"",
                "params": {
                  "sketch": "insideStart",
                  "center": [
                    0,
                    0
                  ],
                  "radius": "c1.Radius"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 16,
                "method": "sketch.create",
                "when": "diameter == \"inner\"",
                "params": {
                  "plane": {
                    "origin": "B",
                    "xAxis": "xd",
                    "normal": "n"
                  },
                  "name": "insideEnd"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 17,
                "method": "sketch.add_circle",
                "when": "diameter == \"inner\"",
                "params": {
                  "sketch": "insideEnd",
                  "center": [
                    0,
                    0
                  ],
                  "radius": "c2.Radius"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 18,
                "method": "solid.ruled",
                "when": "diameter == \"inner\"",
                "params": {
                  "profile1": "insideStart",
                  "profile2": "insideEnd",
                  "name": "inside"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 19,
                "method": "solid.cylinder",
                "when": "diameter == \"inner\"",
                "params": {
                  "start": "A - (L1 + t)*n",
                  "end": "A",
                  "radius": "c1.Radius",
                  "name": "insideStub1"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 20,
                "method": "solid.cylinder",
                "when": "diameter == \"inner\"",
                "params": {
                  "start": "B",
                  "end": "B + (L2 + t)*n",
                  "radius": "c2.Radius",
                  "name": "insideStub2"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 21,
                "method": "solid.boolean",
                "when": "diameter == \"inner\"",
                "params": {
                  "op": "union",
                  "a": "inside",
                  "b": "insideStub1",
                  "name": "inside"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 22,
                "method": "solid.boolean",
                "when": "diameter == \"inner\"",
                "params": {
                  "op": "union",
                  "a": "inside",
                  "b": "insideStub2",
                  "name": "inside"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 23,
                "method": "solid.offset",
                "when": "diameter == \"inner\"",
                "params": {
                  "solid": "inside",
                  "distance": "t",
                  "name": "outside"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 24,
                "method": "solid.cylinder",
                "when": "diameter == \"inner\"",
                "params": {
                  "start": "A - L1*n",
                  "end": "A + (Lt + L2)*n",
                  "radius": "distance(c1.Center, c2.Center) + c1.Radius + c2.Radius + 2*t",
                  "name": "clip"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 25,
                "method": "solid.boolean",
                "when": "diameter == \"inner\"",
                "params": {
                  "op": "intersect",
                  "a": "outside",
                  "b": "clip",
                  "name": "outside"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 26,
                "method": "workspace.select",
                "when": "diameter == \"outer\"",
                "params": {
                  "selector": {
                    "query": {
                      "target": "faces",
                      "from": "outside",
                      "filter": {
                        "condition": "this.SurfaceType == \"planar\""
                      }
                    }
                  },
                  "name": "ends"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 27,
                "method": "solid.hollow",
                "when": "diameter == \"outer\"",
                "params": {
                  "solid": "outside",
                  "openFaces": "ends",
                  "thickness": "t",
                  "name": "pipe"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 28,
                "method": "solid.boolean",
                "when": "diameter == \"inner\"",
                "params": {
                  "op": "difference",
                  "a": "outside",
                  "b": "inside",
                  "name": "pipe"
                }
              }
            ]
          }
        },
        {
          "method": "template.commit",
          "id": 3,
          "params": {
            "result": "pipe"
          }
        }
      ]
    }
  ],
  "translations": {
    "de": {
      "label": "Rohre",
      "templates": {
        "rohradapter": {
          "label": "Rohradapter",
          "category": "Rohre",
          "description": "Adapter zwischen zwei Rohren unterschiedlichen Durchmessers: ein gerader Stutzen des ersten Rohrs, ein Übergang und ein gerader Stutzen des zweiten Rohrs, an beiden Enden offen. Durchmesser und Lage der Rohre werden durch zwei Kreise in einer Ebene angegeben; die Rohre müssen nicht konzentrisch sein (exzentrisches Reduzierstück). Das erste Rohr endet in der Ebene der Kreise, der Übergang verläuft entlang der Normalen des ersten Kreises, das zweite Rohr beginnt im Abstand der Übergangslänge von dieser Ebene. Der Übergang ist eine Regelfläche, die die beiden Kreise Punkt für Punkt verbindet (ein schiefer Kegel). Die Kreise sind entweder die Außen- oder die Innendurchmesser. Die Wand ist überall gleich dick, senkrecht zur Wand gemessen, auch im Übergang: Bei Außendurchmessern wird die massive Außenform ausgehöhlt, bei Innendurchmessern ist die Außenform der Offset der Innenform.",
          "parameters": {
            "c1": {
              "label": "Erstes Rohr",
              "group": "Rohre",
              "description": "Kreis, der Durchmesser und Lage des ersten Rohrs angibt. Beide Kreise liegen in einer Ebene, das erste Rohr endet in dieser Ebene, das zweite ist um die Übergangslänge entlang der Normalen des ersten Kreises verschoben (bei einem in der x/y-Ebene gegen den Uhrzeigersinn gezeichneten Kreis: +z). Die Rohre müssen nicht konzentrisch sein."
            },
            "c2": {
              "label": "Zweites Rohr",
              "group": "Rohre",
              "description": "Kreis, der Durchmesser und Lage des zweiten Rohrs angibt, in der Ebene des ersten Kreises. In Achsrichtung gesehen liegt das zweite Rohr dort, wo dieser Kreis ist."
            },
            "diameter": {
              "label": "Die Kreise sind",
              "group": "Rohre",
              "description": "Ob die Kreise die Außendurchmesser sind (die Wand geht nach innen) oder die Innendurchmesser (die Wand geht nach außen).",
              "options": {
                "outer": "Außendurchmesser",
                "inner": "Innendurchmesser"
              }
            },
            "L1": {
              "label": "Länge des ersten Stutzens",
              "group": "Längen",
              "description": "Länge des geraden Stutzens des ersten Rohrs, vom offenen Ende bis zum Beginn des Übergangs."
            },
            "Lt": {
              "label": "Übergangslänge",
              "group": "Längen",
              "description": "Länge des Übergangs in Achsrichtung, zwischen den beiden geraden Stutzen."
            },
            "L2": {
              "label": "Länge des zweiten Stutzens",
              "group": "Längen",
              "description": "Länge des geraden Stutzens des zweiten Rohrs, vom Ende des Übergangs bis zum offenen Ende."
            },
            "t": {
              "label": "Wandstärke",
              "group": "Wand",
              "description": "Wandstärke, senkrecht zur Wand gemessen, auch im Übergang. Wo die Wand zur Innenseite hin knickt, wird die Innenseite des Knicks mit der Wandstärke als Radius gerundet, damit die Wand dort ihre Dicke behält."
            }
          },
          "checks": [
            "Beide Rohre müssen durch Kreise angegeben werden.",
            "Beide Rohre müssen durch Vollkreise angegeben werden, nicht durch Ellipsen oder Bögen.",
            "Die beiden Kreise müssen in einer Ebene liegen.",
            "Bei Außendurchmessern muss die Wandstärke ({t}) kleiner sein als der Radius beider Kreise ({c1.Radius}, {c2.Radius})."
          ]
        }
      }
    }
  }
}
