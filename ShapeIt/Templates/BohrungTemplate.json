{
  "label": "Holes",
  "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><path d=\"M6 22H24V48L32 56L40 48V22H58V58H6Z\" fill=\"#c9d6e6\" stroke=\"#494c4e\" stroke-width=\"3\" stroke-linejoin=\"round\"/><path d=\"M24 22V48L32 56L40 48V22\" fill=\"#ffffff\" stroke=\"#494c4e\" stroke-width=\"3\" stroke-linejoin=\"round\"/><path d=\"M32 6V60\" stroke=\"#494c4e\" stroke-width=\"1.5\" stroke-dasharray=\"4 3\"/></svg>",
  "templates": [
    {
      "name": "sacklochbohrung",
      "items": [
        {
          "method": "template.begin",
          "id": 1,
          "params": {
            "name": "sacklochbohrung",
            "label": "Blind hole",
            "category": "Holes",
            "description": "Blind hole perpendicular to a face of a solid: the user picks the face and the position on it. The entry edge can be sharp, chamfered at 45° or rounded; the bottom flat, conical (pointed like a drill point or truncated) or a half sphere. The depth is the depth of the cylindrical part. The hole is cut with a revolved tool that reaches one diameter above the face, so material above the face within that height is cut as well.",
            "tags": [
              "hole",
              "blind hole",
              "drill",
              "Bohrung",
              "Sackloch",
              "Senkung"
            ],
            "parameters": [
              {
                "name": "body",
                "value": "block",
                "label": "Body",
                "input": {
                  "kind": "solid",
                  "replace": true,
                  "description": "The solid that gets the hole; it is taken from the picked face."
                }
              },
              {
                "name": "face",
                "value": "top",
                "label": "Face",
                "input": {
                  "kind": "face",
                  "solid": "body",
                  "group": "Position",
                  "order": 1,
                  "description": "The face the hole is drilled into, perpendicular to the face at the position."
                }
              },
              {
                "name": "pos",
                "value": "p(10,10,20)",
                "label": "Position",
                "input": {
                  "kind": "point3",
                  "onFace": "face",
                  "group": "Position",
                  "order": 2,
                  "description": "Center of the hole on the face. Click on the face, snap to a point (e.g. the center of a circular edge) or enter coordinates; the point is put onto the face."
                }
              },
              {
                "name": "d",
                "value": 8,
                "label": "Diameter",
                "input": {
                  "kind": "length",
                  "group": "Hole",
                  "order": 3,
                  "min": 0.01,
                  "description": "Diameter of the hole."
                }
              },
              {
                "name": "depth",
                "value": 15,
                "label": "Depth",
                "input": {
                  "kind": "length",
                  "group": "Hole",
                  "order": 4,
                  "min": 0.01,
                  "description": "Depth of the cylindrical part, measured from the position on the face; a conical or spherical bottom comes on top of it."
                }
              },
              {
                "name": "entry",
                "value": "sharp",
                "label": "Entry",
                "input": {
                  "kind": "enum",
                  "group": "Entry",
                  "order": 5,
                  "optional": true,
                  "options": [
                    {
                      "value": "sharp",
                      "label": "sharp"
                    },
                    {
                      "value": "chamfer",
                      "label": "chamfered (45°)"
                    },
                    {
                      "value": "round",
                      "label": "rounded"
                    }
                  ],
                  "description": "The edge where the hole enters the face: sharp, a 45° chamfer (countersink) or a fillet."
                }
              },
              {
                "name": "entrySize",
                "value": 1,
                "label": "Chamfer / radius",
                "input": {
                  "kind": "length",
                  "group": "Entry",
                  "order": 6,
                  "optional": true,
                  "min": 0.01,
                  "description": "Width of the chamfer or radius of the fillet at the entry; not used for a sharp entry."
                }
              },
              {
                "name": "bottom",
                "value": "flat",
                "label": "Bottom",
                "input": {
                  "kind": "enum",
                  "group": "Bottom",
                  "order": 7,
                  "optional": true,
                  "options": [
                    {
                      "value": "flat",
                      "label": "flat"
                    },
                    {
                      "value": "cone",
                      "label": "cone / truncated cone"
                    },
                    {
                      "value": "sphere",
                      "label": "spherical"
                    }
                  ],
                  "description": "The bottom of the hole: flat, conical like a drill point (a truncated cone with a bottom diameter above 0), or a half sphere."
                }
              },
              {
                "name": "tipAngle",
                "value": 118,
                "label": "Tip angle",
                "input": {
                  "kind": "angle",
                  "group": "Bottom",
                  "order": 8,
                  "optional": true,
                  "min": 1,
                  "max": 179,
                  "description": "Included angle of the conical bottom, 118° for a twist drill; only for a conical bottom."
                }
              },
              {
                "name": "bottomDiameter",
                "value": 0,
                "label": "Bottom diameter",
                "input": {
                  "kind": "length",
                  "group": "Bottom",
                  "order": 9,
                  "optional": true,
                  "min": 0,
                  "description": "Diameter of the flat end of a truncated cone, 0 for a pointed cone; only for a conical bottom."
                }
              }
            ],
            "checks": [
              {
                "condition": "bottomDiameter < d",
                "parameters": [
                  "bottomDiameter",
                  "d"
                ],
                "message": "The bottom diameter ({bottomDiameter}) must be smaller than the diameter of the hole ({d})."
              },
              {
                "condition": "entry == \"sharp\" || entrySize < depth",
                "parameters": [
                  "entrySize",
                  "depth"
                ],
                "message": "The chamfer or radius at the entry ({entrySize}) must be smaller than the depth ({depth})."
              }
            ],
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><path d=\"M6 22H24V48L32 56L40 48V22H58V58H6Z\" fill=\"#c9d6e6\" stroke=\"#494c4e\" stroke-width=\"3\" stroke-linejoin=\"round\"/><path d=\"M24 22V48L32 56L40 48V22\" fill=\"#ffffff\" stroke=\"#494c4e\" stroke-width=\"3\" stroke-linejoin=\"round\"/><path d=\"M32 6V60\" stroke=\"#494c4e\" stroke-width=\"1.5\" stroke-dasharray=\"4 3\"/></svg>"
          }
        },
        {
          "method": "rpc.batch",
          "id": 2,
          "params": {
            "calls": [
              {
                "jsonrpc": "2.0",
                "id": 1,
                "method": "workspace.set",
                "params": {
                  "name": "n",
                  "value": "normal(face, pos)"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 2,
                "method": "workspace.set",
                "params": {
                  "name": "r",
                  "value": "d/2"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 3,
                "method": "workspace.set",
                "params": {
                  "name": "over",
                  "value": "d"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 4,
                "method": "workspace.set",
                "when": "abs(n*v(1,0,0)) < 0.9",
                "params": {
                  "name": "u",
                  "value": "normalize(v(1,0,0) ^ n)"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 5,
                "method": "workspace.set",
                "when": "abs(n*v(1,0,0)) >= 0.9",
                "params": {
                  "name": "u",
                  "value": "normalize(v(0,1,0) ^ n)"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 14,
                "method": "workspace.set",
                "params": {
                  "name": "edgeTolerance",
                  "value": "0.000001*(1 + d)"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 6,
                "method": "workspace.set",
                "params": {
                  "name": "coneHeight",
                  "value": "(r - bottomDiameter/2)/tan(tipAngle*pi/360)"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 7,
                "method": "sketch.create",
                "params": {
                  "plane": {
                    "origin": "pos",
                    "xAxis": "u",
                    "yAxis": "n"
                  },
                  "name": "holeProfile"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 8,
                "method": "sketch.add_polycurve",
                "when": "bottom == \"flat\"",
                "params": {
                  "sketch": "holeProfile",
                  "isClosed": true,
                  "vertices": [
                    {
                      "x": 0,
                      "y": "over",
                      "b": 0
                    },
                    {
                      "x": "r",
                      "y": "over",
                      "b": 0
                    },
                    {
                      "x": "r",
                      "y": "-depth",
                      "b": 0
                    },
                    {
                      "x": 0,
                      "y": "-depth",
                      "b": 0
                    }
                  ]
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 9,
                "method": "sketch.add_polycurve",
                "when": "bottom == \"cone\" && bottomDiameter <= 0",
                "params": {
                  "sketch": "holeProfile",
                  "isClosed": true,
                  "vertices": [
                    {
                      "x": 0,
                      "y": "over",
                      "b": 0
                    },
                    {
                      "x": "r",
                      "y": "over",
                      "b": 0
                    },
                    {
                      "x": "r",
                      "y": "-depth",
                      "b": 0
                    },
                    {
                      "x": 0,
                      "y": "-depth - coneHeight",
                      "b": 0
                    }
                  ]
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 10,
                "method": "sketch.add_polycurve",
                "when": "bottom == \"cone\" && bottomDiameter > 0",
                "params": {
                  "sketch": "holeProfile",
                  "isClosed": true,
                  "vertices": [
                    {
                      "x": 0,
                      "y": "over",
                      "b": 0
                    },
                    {
                      "x": "r",
                      "y": "over",
                      "b": 0
                    },
                    {
                      "x": "r",
                      "y": "-depth",
                      "b": 0
                    },
                    {
                      "x": "bottomDiameter/2",
                      "y": "-depth - coneHeight",
                      "b": 0
                    },
                    {
                      "x": 0,
                      "y": "-depth - coneHeight",
                      "b": 0
                    }
                  ]
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 11,
                "method": "sketch.add_polycurve",
                "when": "bottom == \"sphere\"",
                "params": {
                  "sketch": "holeProfile",
                  "isClosed": true,
                  "vertices": [
                    {
                      "x": 0,
                      "y": "over",
                      "b": 0
                    },
                    {
                      "x": "r",
                      "y": "over",
                      "b": 0
                    },
                    {
                      "x": "r",
                      "y": "-depth",
                      "b": "-tan(pi/8)"
                    },
                    {
                      "x": 0,
                      "y": "-depth - r",
                      "b": 0
                    }
                  ]
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 12,
                "method": "solid.rotate",
                "params": {
                  "profile": "holeProfile",
                  "axis": {
                    "origin": "pos",
                    "direction": "n"
                  },
                  "angle": {
                    "full": true
                  },
                  "name": "tool"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 13,
                "method": "solid.boolean",
                "params": {
                  "op": "difference",
                  "a": "body",
                  "b": "tool",
                  "name": "drilled"
                }
              }
            ]
          }
        },
        {
          "method": "rpc.batch",
          "id": 3,
          "params": {
            "calls": [
              {
                "jsonrpc": "2.0",
                "id": 1,
                "method": "workspace.select",
                "when": "entry != \"sharp\"",
                "params": {
                  "selector": {
                    "query": {
                      "target": "edges",
                      "from": "drilled",
                      "filter": {
                        "condition": "abs(len((this.pointAt(0.5) - pos) ^ n) - r) < edgeTolerance && (this.pointAt(0.5) - pos)*n + depth/2 > 0"
                      }
                    }
                  },
                  "type": "edges",
                  "name": "entryEdges"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 2,
                "method": "feature.chamfer",
                "when": "entry == \"chamfer\"",
                "params": {
                  "solid": "drilled",
                  "edges": "entryEdges",
                  "distance": "entrySize",
                  "name": "result"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 3,
                "method": "feature.fillet",
                "when": "entry == \"round\"",
                "params": {
                  "solid": "drilled",
                  "edges": "entryEdges",
                  "radius": "entrySize",
                  "name": "result"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": 4,
                "method": "workspace.select",
                "when": "entry == \"sharp\"",
                "params": {
                  "selector": "drilled",
                  "name": "result"
                }
              }
            ]
          }
        },
        {
          "method": "template.commit",
          "id": 4,
          "params": {
            "result": "result"
          }
        }
      ]
    }
  ],
  "translations": {
    "de": {
      "label": "Bohrungen",
      "templates": {
        "sacklochbohrung": {
          "label": "Sacklochbohrung",
          "category": "Bohrungen",
          "description": "Sacklochbohrung senkrecht zu einer Fläche eines Körpers: Der Anwender wählt die Fläche und die Position darauf. Der Bohrungseintritt kann scharfkantig, unter 45° angefast oder gerundet sein, der Bohrungsgrund flach, kegelig (spitz wie ein Spiralbohrer oder als Kegelstumpf) oder eine Halbkugel. Die Tiefe ist die Tiefe des zylindrischen Teils. Die Bohrung wird mit einem Drehkörper geschnitten, der einen Durchmesser über die Fläche hinausragt; Material über der Fläche innerhalb dieser Höhe wird mit weggeschnitten.",
          "parameters": {
            "body": {
              "label": "Körper",
              "description": "Der Körper, der die Bohrung bekommt; er ergibt sich aus der gewählten Fläche."
            },
            "face": {
              "label": "Fläche",
              "group": "Lage",
              "description": "Die Fläche, in die gebohrt wird, senkrecht zur Fläche an der Position."
            },
            "pos": {
              "label": "Position",
              "group": "Lage",
              "description": "Mittelpunkt der Bohrung auf der Fläche. Auf die Fläche klicken, auf einen Punkt fangen (z. B. den Mittelpunkt einer Kreiskante) oder Koordinaten eingeben; der Punkt wird auf die Fläche gelegt."
            },
            "d": {
              "label": "Durchmesser",
              "group": "Bohrung",
              "description": "Durchmesser der Bohrung."
            },
            "depth": {
              "label": "Tiefe",
              "group": "Bohrung",
              "description": "Tiefe des zylindrischen Teils, gemessen von der Position auf der Fläche; ein kegeliger oder sphärischer Grund kommt hinzu."
            },
            "entry": {
              "label": "Bohrungseintritt",
              "group": "Eintritt",
              "description": "Die Kante, an der die Bohrung in die Fläche eintritt: scharfkantig, eine 45°-Fase (Senkung) oder eine Rundung.",
              "options": {
                "sharp": "scharfkantig",
                "chamfer": "angefast (45°)",
                "round": "gerundet"
              }
            },
            "entrySize": {
              "label": "Fase / Radius",
              "group": "Eintritt",
              "description": "Breite der Fase oder Radius der Rundung am Eintritt; bei scharfkantigem Eintritt ohne Bedeutung."
            },
            "bottom": {
              "label": "Bohrungsgrund",
              "group": "Grund",
              "description": "Der Grund der Bohrung: flach, kegelig wie eine Bohrerspitze (ein Kegelstumpf bei einem Grunddurchmesser über 0) oder eine Halbkugel.",
              "options": {
                "flat": "flach",
                "cone": "Kegel / Kegelstumpf",
                "sphere": "sphärisch"
              }
            },
            "tipAngle": {
              "label": "Spitzenwinkel",
              "group": "Grund",
              "description": "Spitzenwinkel des kegeligen Grunds, 118° für einen Spiralbohrer; nur bei kegeligem Grund."
            },
            "bottomDiameter": {
              "label": "Grunddurchmesser",
              "group": "Grund",
              "description": "Durchmesser des flachen Endes eines Kegelstumpfs, 0 für eine Kegelspitze; nur bei kegeligem Grund."
            }
          },
          "checks": [
            "Der Grunddurchmesser ({bottomDiameter}) muss kleiner sein als der Durchmesser der Bohrung ({d}).",
            "Die Fase bzw. der Radius am Eintritt ({entrySize}) muss kleiner sein als die Tiefe ({depth})."
          ]
        }
      }
    }
  }
}
